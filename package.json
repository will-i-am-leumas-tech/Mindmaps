{
  "name": "leumas-mindmap-notebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first HUD mindmap notebook built with Node.js, Vite, and React.",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server.js",
    "dev:frontend": "vite --host 0.0.0.0 --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node server.js",
    "check": "npm run build"
  },
  "dependencies": {
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {}
}
